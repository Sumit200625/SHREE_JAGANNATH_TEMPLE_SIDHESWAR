# ===== Server (Vercel -> Project -> Settings -> Environment Variables) =====
DATABASE_URL=postgres://...                 # Neon Postgres (Vercel Storage -> Neon)
JWT_SECRET=                                 # 32+ random chars:  openssl rand -base64 48
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ADMIN_EMAILS=headadmin@gmail.com            # comma separated; these Google accounts become super_admin
STAFF_ROLES=                                # a@gmail.com:seva_manager,b@gmail.com:donation_manager,c@gmail.com:content_editor,d@gmail.com:notice_manager
BLOB_READ_WRITE_TOKEN=                      # auto-added when you create a Vercel Blob store
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===== Public (optional: shows the bank-transfer box on the Donation page) =====
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_ACCOUNT_NO=
VITE_BANK_IFSC=
VITE_BANK_BRANCH=
